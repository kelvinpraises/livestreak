# Shared Docker build context (context = repo root) for both ./Dockerfile (app) and
# ./host/Dockerfile (host server). Each Dockerfile COPYs only the paths it needs, so
# this list just trims bloat/secrets that neither image should ever pull in.

**/node_modules
**/.output
**/dist
**/build
**/.git
**/.DS_Store
**/*.log

# host catalog sqlite projection (materialized from chain; multi-MB; never in an image)
**/*.db
**/*.db-shm
**/*.db-wal

# secrets / local env never go into an image (frontend config is public build-args;
# host runtime config is injected via `docker run --env-file`)
**/.env
**/.env.*
!**/.env.example
host/aa.chains.json
host/aa.chains.*.json
!host/aa.chains.example.json

# reference + workspaces neither image builds from
context
cli
packages/observe
packages/bookmaker
packages/steward

# keep, shared by both images: packages/{core,schema,wallet,contracts,host}
#   app image also copies app/ + packages/options
#   host image also copies host/
