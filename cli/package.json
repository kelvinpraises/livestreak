{
  "name": "@livestreak/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "livestreak": "dist/main.js"
  },
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./agent-client": {
      "types": "./agent-client.d.ts",
      "default": "./dist/agent-client.js"
    }
  },
  "files": [
    "dist/main.js",
    "dist/agent-client.js",
    "agent-client.d.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "NODE_OPTIONS=--conditions=livestreak-dev tsx src/main.ts"
  },
  "dependencies": {
    "@effect/cli": "0.69.2",
    "@effect/platform-node": "0.96.1",
    "effect": "3.21.3",
    "sodium-universal": "5.0.1",
    "viem": "^2.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@livestreak/bookmaker": "file:../packages/bookmaker",
    "@livestreak/contracts": "file:../packages/contracts",
    "@livestreak/host": "file:../packages/host",
    "@livestreak/observe": "file:../packages/observe",
    "@livestreak/options": "file:../packages/options",
    "@livestreak/schema": "file:../packages/schema",
    "@livestreak/wallet": "file:../packages/wallet",
    "@types/node": "^22.15.30",
    "@types/ws": "^8.5.12",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
