# LiveStreak host server — runtime env template.
#
# Blocker #2 for `Deploy host`: the workflow runs `docker run --env-file
# /home/ubuntu/livestreak-host.env`. That file is NOT committed and must exist on the
# box (108.129.133.48). Copy this file there, fill in the real values, then re-run the
# deploy (push, or `gh workflow run "Deploy host"`):
#
#   scp -i ~/.ssh/uburu-key-pair.pem host/livestreak-host.env.example \
#       ubuntu@108.129.133.48:/home/ubuntu/livestreak-host.env
#   # edit on the box, fill the REQUIRED values, chmod 600
#
# Var names are read directly by host/src (grep LIVESTREAK_/LIVEKIT_). Do NOT set
# LIVESTREAK_AA_ALLOW_DEV_KEY in prod — it is a dev-only unsafe bypass.

# --- Server / bind (BIND_HOST/PORT are already baked into the image; override if needed) ---
LIVESTREAK_HOST_ID=livestreak-prod
LIVESTREAK_HOST_BASE_URL=https://<host-public-url>
# LIVESTREAK_HOST_BIND_HOST=0.0.0.0
# LIVESTREAK_HOST_BIND_PORT=8787

# --- Account abstraction (EVM): single-chain env form (REQUIRED for wallet sends) ---
# Alternative: point LIVESTREAK_AA_CHAINS_FILE at a per-chain JSON mounted separately.
LIVESTREAK_AA_CHAIN_ID=
LIVESTREAK_AA_RPC_URL=
LIVESTREAK_AA_BUNDLER_URL=
LIVESTREAK_AA_ENTRY_POINT=
LIVESTREAK_AA_PAYMASTER_ADDRESS=
LIVESTREAK_AA_SAFE_MODULE=
LIVESTREAK_AA_EXECUTOR_PRIVATE_KEY=0xREPLACE_ME
LIVESTREAK_AA_OPERATOR_KEY=0xREPLACE_ME
LIVESTREAK_AA_PAYMASTER_AUTH_TOKEN=REPLACE_ME
# The image sets LIVESTREAK_AA_FROM_DEPLOY=0 (skip the localhost deploy snapshot).

# --- Sui (memory/content sponsor + reads) ---
LIVESTREAK_SUI_NETWORK=mainnet
LIVESTREAK_SUI_RPC_URL=
LIVESTREAK_SUI_DEPLOYMENT=
LIVESTREAK_SUI_SPONSOR_MNEMONIC=REPLACE_ME

# --- Walrus (content blobs + memory relayer) ---
LIVESTREAK_WALRUS_NETWORK=mainnet
LIVESTREAK_WALRUS_MEMORY_RELAYER_URL_OVERRIDE=
LIVESTREAK_WALRUS_REGISTRY_ID_OVERRIDE=
LIVESTREAK_MEMORY_OWNER_KEY=REPLACE_ME
LIVESTREAK_WALLET_SEED=REPLACE_ME

# --- Remote Bridge Console (P4) + LiveKit ---
LIVESTREAK_APP_ORIGIN=https://livestreak.online
LIVESTREAK_REMOTE_GATEWAY_TOKEN=REPLACE_ME
LIVESTREAK_REMOTE_GRANT_KEY=REPLACE_ME
LIVESTREAK_REMOTE_SESSION_TTL_MS=3600000
LIVEKIT_API_KEY=REPLACE_ME
