{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "#server.js": [
        "./src/server.ts"
      ],
      "#deps.js": [
        "./src/deps.ts"
      ],
      "#config/*": [
        "./src/config/*"
      ],
      "#test/*": [
        "./test/*"
      ],
      "#features/*": [
        "./src/features/*"
      ],
      "#http/*": [
        "./src/http/*"
      ],
      "#database/*": [
        "./src/database/*"
      ],
      "#storage/*": [
        "./src/storage/*"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
