{
  "name": "@livestreak/observe",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "livestreak-dev": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#pipeline/*": { "livestreak-dev": "./src/pipeline/*", "default": "./dist/pipeline/*" },
    "#adapters/*": { "livestreak-dev": "./src/adapters/*", "default": "./dist/adapters/*" },
    "#run/*": { "livestreak-dev": "./src/run/*", "default": "./dist/run/*" },
    "#bridge/*": { "livestreak-dev": "./src/bridge/*", "default": "./dist/bridge/*" },
    "#scope/*": { "livestreak-dev": "./src/scope/*", "default": "./dist/scope/*" },
    "#market/*": { "livestreak-dev": "./src/market/*", "default": "./dist/market/*" },
    "#flows/*": { "livestreak-dev": "./src/flows/*", "default": "./dist/flows/*" },
    "#builtins.js": { "livestreak-dev": "./src/builtins.ts", "default": "./dist/builtins.js" }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "tsc -w -p tsconfig.build.json"
  },
  "dependencies": {
    "@livestreak/contracts": "file:../contracts",
    "@livestreak/core": "file:../core",
    "@livestreak/schema": "file:../schema",
    "@livestreak/wallet": "file:../wallet",
    "effect": "3.21.3",
    "uuid": "^11.1.1",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "ws": "^8.18.0"
  }
}
